pragma language_version 0.23;

import CompactStandardLibrary;

// ---------------------------------------------------------------------------
// Public ledger state: visible to anyone reading the chain.
// ---------------------------------------------------------------------------
export ledger question: Opaque<"string">;
export ledger yesVotes: Counter;
export ledger noVotes: Counter;
// Nullifiers of everyone who has voted. Stops double-voting without ever
// revealing *who* voted or *how* - only that a vote with this nullifier exists.
export ledger voted: Set<Bytes<32>>;

constructor(question_: Opaque<"string">) {
  question = disclose(question_);
}

// ---------------------------------------------------------------------------
// Private witnesses: resolved locally by the caller's wallet and never leave
// the prover unless explicitly passed to disclose().
// ---------------------------------------------------------------------------

// A persistent private identity for this voter. Never written to the ledger
// directly - only its hash (the nullifier) ever becomes public.
witness mySecretId(): Bytes<32>;
// The voter's choice for the current call, set locally immediately before
// casting a vote. true = yes, false = no.
witness myChoice(): Boolean;

export circuit castVote(): [] {
  // A nullifier derived from the caller's private secret ID stops the same
  // person from voting twice, without ever revealing who they are.
  const nullifier = disclose(nullifierFor(mySecretId()));
  assert(!voted.member(nullifier), "You have already voted");
  voted.insert(nullifier);

  // The tally is the public output of the poll, so the choice must be
  // disclosed here to select which counter is incremented - but nothing
  // ties this disclosed choice back to the voter's identity, since the
  // nullifier reveals only "someone voted", never who.
  if (disclose(myChoice())) {
    yesVotes.increment(1);
  } else {
    noVotes.increment(1);
  }
}

// Derives the public nullifier for a given private secret ID. Exposed so
// callers can locally check whether their identity has already voted,
// without needing to disclose the secret ID itself.
export circuit nullifierFor(secretId: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "shadowpoll:nf:"), secretId]);
}
